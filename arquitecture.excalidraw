      "link": null,
      "locked": false,
      "text": "Each level in your program should be separate by a clear barrier,\nthe transport layer, the service layer, the storage layer...",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each level in your program should be separate by a clear barrier,\nthe transport layer, the service layer, the storage layer...",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oy0Q4teGkjKTn4YeL5s7K",
      "type": "text",
      "x": 359.7920837402344,
      "y": 850,
      "width": 651.2398071289062,
      "height": 45,
