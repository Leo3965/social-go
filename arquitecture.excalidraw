      "isDeleted": false,
      "boundElements": [],
      "updated": 1789896000805,
      "link": null,
      "locked": false,
      "text": "Dependency Inversion Principle (DIP)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dependency Inversion Principle (DIP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IfaNv-K634jK1EqYsZfVE",
      "type": "text",
      "x": 359.7920837402344,
      "y": 905.5,
      "width": 586.591552734375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1608767233,
      "version": 410,
      "versionNonce": 2055343535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789896315045,
      "link": null,
      "locked": false,
      "text": "You're injecting the dependencies in your layers. You don't directly call them\nWhy? It promotes loose coupling and makes it easier to test our programs",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You're injecting the dependencies in your layers. You don't directly call them\nWhy? It promotes loose coupling and makes it easier to test our programs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h2wPouHakcK5Grv7d01Hm",
      "type": "text",
      "x": 359.7920837402344,
      "y": 981,
      "width": 403.81182861328125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
