    },
    {
      "id": "cvykodzsNt3iHW-Q6zjIG",
      "type": "text",
      "x": 359.7920837402344,
      "y": 1033.5,
      "width": 734.0633544921875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1562781647,
      "version": 784,
      "versionNonce": 1641000431,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789896315045,
      "link": null,
      "locked": false,
      "text": "By organizing your code in a modular and flexible way, you can more easily\nintroduce new features, refactor existing code, and respond to evolving business requirements\n\nYour systems should be asy to change, if you have to change a lot of existing code to add\na new feature your doind it wrong",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "By organizing your code in a modular and flexible way, you can more easily\nintroduce new features, refactor existing code, and respond to evolving business requirements\n\nYour systems should be asy to change, if you have to change a lot of existing code to add\na new feature your doind it wrong",
      "autoResize": true,
      "lineHeight": 1.25
    },
