      "isDeleted": false,
      "boundElements": [],
      "updated": 1789896315045,
      "link": null,
      "locked": false,
      "text": "Adaptability to Change",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adaptability to Change",
      "autoResize": true,
