      "type": "text",
      "x": 359.7920837402344,
      "y": 1217.5,
      "width": 760.6873168945312,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 344567841,
      "version": 639,
      "versionNonce": 635584047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789896315045,
      "link": null,
      "locked": false,
      "text": "And finally, focus on delivering value to your users, they are the ones who will be paying your bills\nat the end of the month. So focus on the business value",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And finally, focus on delivering value to your users, they are the ones who will be paying your bills\nat the end of the month. So focus on the business value",
      "autoResize": true,
      "lineHeight": 1.25
    },
